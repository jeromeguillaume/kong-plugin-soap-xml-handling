<?xml version="1.0" encoding="UTF-8"?>

<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:tns="http://tempuri.org"
                  name="calculator_DEFINITION_Multiply_Divide"
                  targetNamespace="http://tempuri.org/">
  <wsdl:types>
    <!-- This WSDL adds 2 x XSD definitions by using <xsd:include> and <xsd:import> -->
    <xsd:schema elementFormDefault="qualified" 
                xmlns:xsd="http://www.w3.org/2001/XMLSchema"                 
                targetNamespace="http://tempuri.org/">
      <!-- comment for debug #A: it must be there after the recursive import -->
      <xsd:include schemaLocation="calculator.request.Multiply.Divide.xsd"/>
      <!-- comment for debug #B: it must be there after the recursive import -->
    </xsd:schema>
    <xsd:schema elementFormDefault="qualified" 
                xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
                targetNamespace="http://tempuri.org/">
      <!-- comment for debug #C: it must be there after the recursive import -->
      <xsd:import import="" schemaLocation="calculator.response.Multiply.Divide.xsd"/>
      <!-- comment for debug #D: it must be there after the recursive import -->
    </xsd:schema>
  </wsdl:types>
  <wsdl:message name="MultiplySoapIn">
    <wsdl:part name="parameters" element="tns:Multiply" />
  </wsdl:message>
  <wsdl:message name="MultiplySoapOut">
    <wsdl:part name="parameters" element="tns:MultiplyResponse" />
  </wsdl:message>
  <wsdl:message name="DivideSoapIn">
    <wsdl:part name="parameters" element="tns:Divide" />
  </wsdl:message>
  <wsdl:message name="DivideSoapOut">
    <wsdl:part name="parameters" element="tns:DivideResponse" />
  </wsdl:message>
  <wsdl:portType name="CalculatorPortType"> 
    <wsdl:operation name="Multiply">
      <wsdl:input message="tns:MultiplySoapIn" />
      <wsdl:output message="tns:MultiplySoapOut" />
    </wsdl:operation>
    <wsdl:operation name="Divide">
      <wsdl:input message="tns:DivideSoapIn" />
      <wsdl:output message="tns:DivideSoapOut" />
    </wsdl:operation>
  </wsdl:portType>
</wsdl:definitions>